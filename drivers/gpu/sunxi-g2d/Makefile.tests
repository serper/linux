# Copyright (C) 2025 Sergio Perez
# SPDX-License-Identifier: GPL-2.0-or-later

# Toolchain for Alpine Linux with musl
CC = arm-linux-musleabihf-gcc
KERNEL_DIR = /home/sergio/source/t113/kernel-t113
KERNEL_HEADERS = $(KERNEL_DIR)/include/uapi
ALPINE_ROOTFS = /home/sergio/source/t113/rootfs-alpine

CFLAGS = -Wall -O2 --sysroot=$(ALPINE_ROOTFS) -I$(KERNEL_HEADERS)
LDFLAGS = --sysroot=$(ALPINE_ROOTFS)

# Test programs
TESTS = test-fillrect-rcq test-fillrect-simple test-minimal-fillrect test-fillrect-userspace

.PHONY: all clean install

all: $(TESTS)

# RCQ fillrect test (new)
test-fillrect-rcq: test-fillrect-rcq.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)
	@echo "Built: $@"

# Simple fillrect test
test-fillrect-simple: test-fillrect-simple.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)
	@echo "Built: $@"

# Minimal fillrect test
test-minimal-fillrect: test-minimal-fillrect.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)
	@echo "Built: $@"

# Fillrect userspace test
test-fillrect-userspace: test-fillrect-userspace.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)
	@echo "Built: $@"

clean:
	rm -f $(TESTS)
	@echo "Cleaned test binaries"

# Install to board
install: all
	@echo "Copying tests to board (10.42.0.1)..."
	scp test-fillrect-rcq spuc@10.42.0.1:/home/spuc/
	@echo "✓ test-fillrect-rcq copied to board"

help:
	@echo "G2D Test Makefile"
	@echo "================="
	@echo ""
	@echo "Targets:"
	@echo "  all              - Build all tests (default)"
	@echo "  clean            - Remove built binaries"
	@echo "  install          - Copy test-fillrect-rcq to board"
	@echo "  help             - Show this help"
	@echo ""
	@echo "Tests:"
	@echo "  test-fillrect-rcq       - Test RCQ path (NEW)"
	@echo "  test-fillrect-simple    - Simple fillrect test"
	@echo "  test-minimal-fillrect   - Minimal fillrect test"
	@echo "  test-fillrect-userspace - Fillrect userspace test"
